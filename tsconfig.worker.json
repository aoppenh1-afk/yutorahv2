{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "rootDir": ".",
    "outDir": ".worker-build",
    "noEmitOnError": true
  },
  "include": ["apps/worker/src/**/*.ts", "packages/**/*.ts"],
  "exclude": ["node_modules", "apps/worker/test"]
}
