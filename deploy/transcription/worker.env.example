# Install as /etc/yutorah-worker.env, root:yutorah-worker 0640. Never commit real values.
# Peer authentication on the same VM avoids a database password.
DATABASE_URL=postgresql:///yutorah_transcription?host=/var/run/postgresql
WORKER_STATE_DIR=/var/lib/yutorah-worker
ACP_RUNTIME_DIR=/opt/antigravity-acp/1.2.1
ACP_CONCURRENCY=5
ACP_MODEL=gemini-3.8-flash-medium
NOTES_PROVIDER=opencode
NOTES_CONCURRENCY=2
OPENCODE_EXECUTABLE=/usr/local/bin/opencode-notes
OPENCODE_VERSION=1.18.33
# Connect OpenCode Zen for this service user. Generation and helper models are
# pinned to Muse Contributor Free; there is no paid or Gemini fallback.
TRANSCRIPTION_SKILL_PATH=/opt/yutorah/packages/transcription/skills/lectern-transcription/SKILL.md
CATALOG_POLL_MS=300000
CATALOG_DEEP_POLL_MS=3600000
# Set true after completing one short and one long shiur on the VM.
CATALOG_ENABLED=false
