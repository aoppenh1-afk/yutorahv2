[Unit]
Description=YU Torah read-only transcripts, notes and search
After=network-online.target postgresql.service

[Service]
Type=simple
User=yutorah-search
Group=yutorah-search
WorkingDirectory=/opt/yutorah-operator
EnvironmentFile=/etc/yutorah-search.env
UMask=0077
ExecStart=/opt/yutorah-operator/bin/node node_modules/tsx/dist/cli.mjs apps/notes-only/src/content-cli.ts
Restart=on-failure
RestartSec=15
TimeoutStopSec=45
KillMode=control-group
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
