{
  "name": "yutorah-study",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build && node scripts/build-offline.mjs dist/client",
    "start": "wrangler dev --config dist/server/wrangler.json --persist-to .wrangler/state",
    "lint": "oxlint",
    "performance:budgets": "node scripts/performance-budgets.mjs",
    "audit": "node --test tests/glob-dependency.test.mjs && npm audit --audit-level=high",
    "format": "oxfmt",
    "test:learning": "node --test tests/learning.test.mjs tests/library.test.mjs tests/discovery.test.mjs tests/trending.test.mjs",
    "performance:fixtures": "node scripts/performance-fixtures.mjs",
    "test:performance": "tsx --test tests/performance.test.ts",
    "test:api": "node --test tests/upstream.test.mjs && tsx --test tests/shiur-views.test.tsx",
    "test:player": "node --test tests/player.test.mjs",
    "test:sources": "tsx --test tests/sources.test.ts tests/source-creator.test.ts tests/source-preparation.test.ts",
    "sources:prepare": "tsx scripts/prepare-sources.ts",
    "sources:evaluate": "tsx scripts/evaluate-sources.ts",
    "test:live": "node --test tests/live-api.test.mjs",
    "test:search": "node tests/search.test.mjs && node --test tests/complete-search.test.mjs tests/d1-http.test.mjs tests/title-index.test.mjs tests/autocomplete.test.mjs",
    "trending:warm": "tsx scripts/warm-trending.ts",
    "search:index": "tsx scripts/index-search-titles.ts",
    "search:transfer": "tsx scripts/transfer-search-titles.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.search.jsonc",
    "test:notes-vm": "node --test tests/notes-catalog-fetch.test.mjs tests/notes-catalog-vm.test.mjs tests/notes-deployment.test.mjs tests/notes-transcript.test.mjs",
    "build:vercel": "DEPLOY_TARGET=vercel NITRO_PRESET=vercel vinext build && node scripts/build-offline.mjs .vercel/output/static",
    "data:maintain": "tsx scripts/maintain-data.ts",
    "test:maintenance": "tsx --test tests/data-maintenance.test.ts",
    "search:schema:migrate": "tsx scripts/migrate-search-schema.ts",
    "search:schema:check": "tsx scripts/check-search-schema.ts",
    "pretest:maintenance": "node scripts/setup-test-database.mjs",
    "notes:only": "node scripts/notes.mjs",
    "notes:package": "node scripts/package-notes-pipeline.mjs",
    "test:notes-only": "tsx --test tests/notes-only.test.ts tests/notes-runtime.test.ts tests/notes-rollout.test.ts tests/opencode-acp.test.ts tests/opencode-temp.test.ts tests/tidb-notes.test.ts",
    "test:notes-export": "tsx --test tests/notes-export.test.ts",
    "test:notifications": "tsx --test tests/account-notifications.test.ts tests/teacher-notification-preferences.test.ts",
    "notifications:deploy": "node scripts/deploy-notifications.mjs",
    "notifications:verify": "node scripts/verify-notifications.mjs",
    "test:account-library": "tsx --test tests/account-library.test.ts tests/account-library-db.test.ts",
    "account-library:verify": "tsx scripts/verify-account-library.ts",
    "account-library:deploy": "node scripts/deploy-account-library.mjs",
    "test:parity": "tsx --test tests/feature-parity.test.ts tests/catalog-artwork.test.ts tests/catalog-loading.test.ts tests/catalog-loading-view.test.tsx tests/topic-groups.test.ts tests/teacher-profile.test.tsx tests/teacher-popularity-client.test.ts",
    "test:downloads": "tsx --test tests/audio-download.test.ts tests/offline-client.test.ts tests/offline-content.test.ts && node --test tests/offline-worker.test.mjs && node --test tests/downloads-browser.test.mjs",
    "test:content": "tsx --test tests/transcript-archive.test.ts tests/transcript-database.test.ts tests/transcript-gateway.test.ts tests/official-transcript.test.ts tests/read-cache.test.ts tests/publication-budget.test.ts tests/publication.test.ts tests/search-server.test.ts tests/content-tunnel.test.ts tests/search-postgres.test.ts tests/search-schema.test.ts",
    "content:serve": "tsx apps/notes-only/src/content-cli.ts",
    "pretest:content": "node scripts/setup-test-database.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/auth-js": "^2.117.3",
    "@supabase/postgrest-js": "^2.117.3",
    "@supabase/supabase-js": "^2.117.3",
    "@tidbcloud/serverless": "0.3.0",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "docx": "^9.9.0",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.11.2",
    "lucide-react": "1.31.0",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "react-server-dom-webpack": "19.2.8",
    "remark-parse": "^11.0.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "unified": "^11.0.5",
    "vinext": "1.0.0-beta.5",
    "web-push": "^3.6.7",
    "web-vitals": "6.2.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.2",
    "@cloudflare/workers-types": "5.20260926.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "braces": "file:vendor/yutorah-braces-3.0.4-yutorah.0.tgz",
    "jszip": "^3.10.2",
    "nitro": "3.0.260903-beta",
    "oxfmt": "0.67.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "pdfjs-dist": "^6.4.299",
    "playwright": "1.58.2",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite": "8.0.16",
    "wrangler": "4.144.0"
  },
  "overrides": {
    "braces": "$braces",
    "miniflare": {
      "sharp": "0.35.5"
    },
    "vinext": {
      "image-size": "2.0.3"
    }
  },
  "type": "module"
}
